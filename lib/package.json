{
  "name": "neurosym",
  "version": "0.1.0",
  "description": "Portable core of the neuro-symbolic exploratory harness: World, Observer (code | dsl), Formula, Judge, Eval.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./foxhounds": "./src/worlds/foxhounds/index.ts",
    "./orbit": "./src/worlds/orbit/index.ts",
    "./grid": "./src/worlds/grid/index.ts",
    "./cells": "./src/worlds/cells/index.ts",
    "./messages": "./src/worlds/messages/index.ts",
    "./lab": "./src/lab.ts",
    "./node": "./src/runtime/node-vm.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.ts\"",
    "bundle": "node scripts/harness-bundle.mjs",
    "bundle:check": "node scripts/harness-bundle.mjs --check",
    "view": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/journal-view.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "typescript": "5.9"
  }
}
