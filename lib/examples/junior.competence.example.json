  "execution": { "harness": "<commit>", "checkers": { "protocol": 1, "request": 1, "proposal": 1 }, "snapshots": ["qwenputer-npz+twin@1"], "judge": "<the Judge's model>", "teacher": null },
  "sampling": { "seed": 20261029 },
